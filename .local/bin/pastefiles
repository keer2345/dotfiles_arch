#!/usr/bin/env python3
"""从 Wayland 剪贴板读取文件 URI，把文件复制到当前目录。

作为 cpfile 的逆向操作：cpfile 把文件放进剪贴板，pastefiles 把它们取出来
放到当前终端所在目录。同名文件直接覆盖（用户选择的行为）。

成功时打印复制的文件名（每行一个，供 zsh widget 显示提示）并返回 0；
剪贴板里没有文件（只有文本）或全是无效 URI 时返回 1，让调用方 fallback 到文本粘贴。
"""
import shutil
import subprocess
import sys
import urllib.parse
from pathlib import Path


def read_clipboard(mime: str) -> str | None:
    try:
        r = subprocess.run(
            ["wl-paste", "-t", mime],
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0 or not r.stdout.strip():
        return None
    return r.stdout


def extract_uris() -> list[str] | None:
    """按优先级尝试两种文件剪贴板格式，返回 file:// URI 列表。"""
    for mime in ("x-special/gnome-copied-files", "text/uri-list"):
        data = read_clipboard(mime)
        if data is None:
            continue
        lines = data.splitlines()
        if mime == "x-special/gnome-copied-files":
            # 首行是动作 copy/cut，终端里一律按复制处理（避免误删源文件）
            lines = lines[1:]
        return [ln.strip() for ln in lines if ln.strip().startswith("file://")]
    return None


def main() -> int:
    uris = extract_uris()
    if not uris:
        return 1

    dest = Path.cwd()
    copied: list[str] = []
    for uri in uris:
        parsed = urllib.parse.urlparse(uri)
        if parsed.scheme != "file":
            continue
        src = Path(urllib.parse.unquote(parsed.path))
        if not src.is_file():
            print(f"跳过不存在的文件: {src}", file=sys.stderr)
            continue
        target = dest / src.name
        shutil.copy2(src, target)
        copied.append(src.name)

    if not copied:
        return 1

    for name in copied:
        print(name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
